# -----------------------------------------------------------------------------
# Environment Variables Example for 3D Personal Brand & Solutions Platform
# -----------------------------------------------------------------------------

# PostgreSQL database connection string (Neon Postgres or any PostgreSQL database).
# When unset in local development, an embedded in-memory/WASM PGLite Postgres engine is used automatically.
# Example: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Host and Port configuration (default: 0.0.0.0:8080)
PORT=8080
HOST=0.0.0.0
